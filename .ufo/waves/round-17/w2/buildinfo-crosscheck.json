  "divergences": [
    {
      "claim": "probe docstring says it mirrors elfExe.DataStart \"L455-466\" incl. a fallback to the first writable non-executable PT_LOAD",
      "demonstration": "cp esbuild-0.21.5 carrier to /tmp/r17-bix/esb-renamed; objcopy --rename-section .go.buildinfo=.notgobuildinf; `go version -m` -> \"could not read Go build info ... not a Go executable\" (exit 1); probe -> found:true go_version:go1.20.12 modinfo_first_line:\"path\\tgithub.com/evanw/esbuild/cmd/esbuild\" via search_space \"first writable non-executable PT_LOAD\"",
      "fact": "installed Go 1.27.3 src/debug/buildinfo/buildinfo.go L455-462: DataStart only scans sections for \".go.buildinfo\" and returns (0,0) -> errNotGoExe; no PT_LOAD fallback exists",
      "id": "BIX-1",
      "impact": "probe reports Go build info that the official toolchain denies; probe is strictly a superset of go version -m on stripped/renamed-section ELFs; contract \"independent stdlib reader\" semantics diverge from debug/buildinfo",
      "where": "tools/buildinfo-probe.py:162-172 (elf_search_space)"
    },
    {
      "claim": "limitations say \"PE/Mach-O/XCOFF/Plan 9 are sniffed but not decoded\"; sniff_format (L275-286) has no Plan 9 magic check",
      "fact": "buildinfo.go hasPlan9Magic at L273 checks a.out magics; sniff_format returns \"unrecognized\" for a Plan 9 binary, not \"plan9\"",
      "id": "BIX-2",
      "impact": "cosmetic: wrong category label in output for a format class the docstring claims is sniffed",
      "where": "tools/buildinfo-probe.py:55 and 302-303"
    },
    {
      "claim": "misaligned-magic tail handling differs: Go returns errNotGoExe when the next aligned offset exceeds the final chunk buffer (L395-399); probe sets data_offset past end and continues to a clean NotGo",
      "id": "BIX-3",
      "impact": "semantic only: both yield not-found; no version divergence possible",
      "where": "tools/buildinfo-probe.py:230-232 vs buildinfo.go:392-402"
    },
    {
      "claim": "probe rejects inline version/modinfo strings >1MiB that the toolchain would accept",
      "id": "BIX-4",
      "impact": "latent false NotGo on pathological modinfo; not observed in any carrier",
      "where": "tools/buildinfo-probe.py:55 MAX_STRING=1<<20 vs saferio.ReadDataAt cap (~10MiB) in buildinfo.go:420"
    }
