HELP_VERIFY:
  usage: custody-pair.py verify [-h] [--live] [--require-paths N]
                                receipt_a [receipt_b]
  
  positional arguments:
    receipt_a          reference receipt
    receipt_b          candidate receipt
  
  options:
    -h, --help         show this help message and exit
    --live             compare receipt_a against the live filesystem
    --require-paths N  exit 2 (USAGE) when the reference carries fewer than N
                       paths (D3 coverage gate)
HELP_SELFTEST:
  usage: custody-pair.py selftest [-h] [--scratch SCRATCH]
  
  options:
    -h, --help         show this help message and exit
    --scratch SCRATCH  fixture root (default: $CUSTODY_PAIR_SCRATCH, /dev/shm,
                       /var/tmp); a missing / non-directory / `/tmp` base is a
                       USAGE exit 2
