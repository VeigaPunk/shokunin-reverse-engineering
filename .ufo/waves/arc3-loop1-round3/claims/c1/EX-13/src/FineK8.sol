pragma solidity ^0.8.0;

contract FineK8 {
    function g0(uint256 x) external returns (uint256) { return x + 1; }
    function g1(uint256 x) external returns (uint256) { return x + 2; }
    function g2(uint256 x) external returns (uint256) { return x + 3; }
    function g3(uint256 x) external returns (uint256) { return x + 4; }
    function g4(uint256 x) external returns (uint256) { return x + 5; }
    function g5(uint256 x) external returns (uint256) { return x + 6; }
    function g6(uint256 x) external returns (uint256) { return x + 7; }
    function g7(uint256 x) external returns (uint256) { return x + 8; }
}
