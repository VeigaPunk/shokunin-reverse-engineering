usage: c1-counter.py [-h] [--root ROOT] [--rev REV] [--freeze FREEZE]
                     [--pkg65 PKG65] [--json-out JSON_OUT] [--unblob UNBLOB]
                     [--work WORK] [--rea-timeout REA_TIMEOUT] [--no-rerun]
                     [--selftest] [--dev-arm] [--arm-dir ARM_DIR]
                     [--arm-ids ARM_IDS] [--run-rea]
                     [--verify-receipt VERIFY_RECEIPT]

options:
  -h, --help            show this help message and exit
  --root ROOT
  --rev REV
  --freeze FREEZE
  --pkg65 PKG65
  --json-out JSON_OUT
  --unblob UNBLOB
  --work WORK           scratch directory (default
                        $HYAKU_SCRATCH/kaidoku-r49/counter)
  --rea-timeout REA_TIMEOUT
  --no-rerun
  --selftest
  --dev-arm
  --arm-dir ARM_DIR     directory of captured REA envelopes: <id>/after.json
                        (dev arm)
  --arm-ids ARM_IDS     comma-separated carrier ids (dev arm)
  --run-rea             dev arm: run REA 6.5.0 on the carrier bytes into
                        scratch (never writes corpus/evidence/round-49/c1)
  --verify-receipt VERIFY_RECEIPT
                        exit 0 if the receipt at PATH carries a counter_sha256
                        that describes the counter file it names
