slug: r14-gitignore-probe
cmd: D=$(mktemp -d -p /fast/scratch/hyaku/kaidoku-r50/w3-SentReceipts); git -C $D init -q; cp /home/vgpnk/Projects/shokunin/kaidoku-shokunin/.gitignore $D/.gitignore; cd $D; mkdir -p tools/round-50; printf V > tools/round-50/x.image; printf V > tools/round-50/x.bin; printf V > x.sqsh; git add -A --dry-run; git check-ignore -v tools/round-50/x.image tools/round-50/x.bin x.sqsh; echo check-ignore-exit=$?; rm -rf $D
