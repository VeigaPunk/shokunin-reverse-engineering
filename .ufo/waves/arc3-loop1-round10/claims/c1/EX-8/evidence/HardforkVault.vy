# @version ^0.4.0

@external
@view
def read_alpha(x: uint256) -> uint256:
    return x + 1

@external
@view
def read_beta(x: uint256) -> uint256:
    return x + 2

@external
@view
def read_gamma(x: uint256) -> uint256:
    return x + 3

@external
@view
def read_delta(x: uint256) -> uint256:
    return x + 4

@external
@view
def read_epsilon(x: uint256) -> uint256:
    return x + 5

@external
@view
def read_zeta(x: uint256) -> uint256:
    return x + 6

@external
@view
def read_eta(x: uint256) -> uint256:
    return x + 7

@external
@view
def read_theta(x: uint256) -> uint256:
    return x + 8
