
# External Interfaces
interface K8:
    def f0(x: uint256) -> uint256: view
    def f1(x: uint256) -> uint256: view
    def f2(x: uint256) -> uint256: view
    def f3(x: uint256) -> uint256: view
    def f4(x: uint256) -> uint256: view
    def f5(x: uint256) -> uint256: view
    def f6(x: uint256) -> uint256: view
    def f7(x: uint256) -> uint256: view

