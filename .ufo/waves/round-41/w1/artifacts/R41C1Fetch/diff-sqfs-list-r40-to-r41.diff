+    def lookup(self, rel):
+        """Resolve one POSIX path relative to the image root.
+
+        Return ``(kind, payload)``: ``kind`` is ``dir``, ``file``, ``symlink``
+        or a special kind (``char-device`` …); ``payload`` is the inode node
+        for directories, regular and special files and the target string for
+        symlinks.  The path is taken literally -- a component that is a
+        symlink is NOT followed (round 41: no link inside a member can
+        redirect the fetch chain).  An absent path raises ``SqfsError``.
+        """
+        want = rel
+        while want.startswith('./'):
+            want = want[2:]
+        want = want.lstrip('/')
+        if want in ('', '.'):
+            return 'dir', self.inode(self.root_inode)
+        dirs, files, links, specials = self.walk()
+        if want in files:
+            return 'file', files[want]
+        if want in dirs:
+            return 'dir', dirs[want]
+        if want in links:
+            return 'symlink', links[want]
+        for path, node in specials:
+            if path == want:
+                return node['kind'], node
+        raise SqfsError('%r is not in the image' % (rel,))
+
+
+def extract_file(img, rel):
+    """Return the bytes of the regular file ``rel`` in ``img``.
+
+    Fails closed: an absent path, or one that is not a regular file, raises
+    ``SqfsError`` instead of returning empty or partial data; the byte count
+    is checked against the inode's ``file_size``.
+    """
+    kind, node = img.lookup(rel)
+    if kind != 'file':
+        raise SqfsError('%r is a %s, not a regular file' % (rel, kind))
+    out = bytearray()
+    for chunk in img.iter_file_data(node):
+        out.extend(chunk)
+    if len(out) != node['file_size']:
+        raise SqfsError('%r: read %d bytes, inode declares %d'
+                        % (rel, len(out), node['file_size']))
+    return bytes(out)
+
 
