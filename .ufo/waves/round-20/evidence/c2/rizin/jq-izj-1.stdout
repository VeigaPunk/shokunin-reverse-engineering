\"string\":\"jq: invalid JSON text passed to --argjson\\n\"},{\"vaddr\":21096,\"paddr\":21096,\"ordinal\":11,\"size\":60,\"length\":59,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"jq: --%s takes two parameters (e.g. --%s varname filename)\\n\"},{\"vaddr\":21160,\"paddr\":21160,\"ordinal\":12,\"size\":32,\"length\":31,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"jq: Bad JSON in --%s %s %s: %s\\n\"},{\"vaddr\":21192,\"paddr\":21192,\"ordinal\":13,\"size\":587,\"length\":586,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"jq - commandline JSON processor [version %s]\\n\\nUsage:\\tjq [options] <jq filter> [file...]\\n\\tjq [options] --args <jq filter> [strings...]\\n\\tjq [options] --jsonargs <jq filter> [JSON_TEXTS...]\\n\\njq is a tool for processing JSON inputs, applying the given filter to\\nits JSON text inputs and producing the filter's results as JSON on\\nstandard output.\\n\\nThe simplest filter is ., which copies jq's input to its output\\nunmodified except for formatting. For more advanced filters see\\nthe jq(1) manpage (\\\"man jq\\\") and/or https://jqlang.org/.\\n\\nExample:\\n\\n\\t$ echo '{\\\"foo\\\": 0}' | jq .\\n\\t{\\n\\t  \\\"foo\\\": 0\\n\\t}\\n\\n\"},{\"vaddr\":21784,\"paddr\":21784,\"ordinal\":14,\"size\":2046,\"length\":2045,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"Command options:\\n  -n, --null-input          use `null` as the single input value;\\n  -R, --raw-input           read each line as string instead of JSON;\\n  -s, --slurp               read all inputs into an array and use it as\\n                            the single input value;\\n  -c, --compact-output      compact instead of pretty-printed output;\\n  -r, --raw-output          output strings without escapes and quotes;\\n      --raw-output0         implies -r and output NUL after each output;\\n  -j, --join-output         implies -r and output without newline after\\n                            each output;\\n  -a, --ascii-output        output strings by only ASCII characters\\n                            using escape sequences;\\n  -S, --sort-keys           sort keys of each object on output;\\n  -C, --color-output        colorize JSON output;\\n  -M, --monochrome-output   disable colored output;\\n      --tab                 use tabs for indentation;\\n      --indent n            use n spaces for indentation (max 7 spaces);\\n      --unbuffered          flush output stream after each output;\\n      --stream              parse the input value in streaming fashion;\\n      --stream-errors       implies --stream and report parse error as\\n                            an array;\\n      --seq                 parse input/output as application/json-seq;\\n  -f, --from-file           load the filter from a file;\\n  -L, --library-path dir    search modules from the directory;\\n      --arg name value      set $name to the string value;\\n      --argjson name value  set $name to the JSON value;\\n      --slurpfile name file set $name to an array of JSON values read\\n                            from the file;\\n      --rawfile name file   set $name to string contents of file;\\n      --args                consume remaining arguments as positional\\n                            string values;\\n      --jsonargs            consume remaining arguments as positional\\n                            JSON values;\\n  -e, --exit-status         set exit status code based on the output;\"},{\"vaddr\":23830,\"paddr\":23830,\"ordinal\":15,\"size\":327,\"length\":326,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"  -V, --version             show the version;\\n  --build-configuration     show jq's build configuration;\\n  -h, --help                show the help;\\n  --                        terminates argument processing;\\n\\nNamed arguments are also available as $ARGS.named[], while\\npositional arguments are available as $ARGS.positional[].\\n\"},{\"vaddr\":24160,\"paddr\":24160,\"ordinal\":16,\"size\":447,\"length\":446,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"--prefix=/usr 'CFLAGS=-march=x86-64 -mtune=generic -O2 -pipe -fno-plt -fexceptions         -Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security         -fstack-clash-protection -fcf-protection         -fno-omit-frame-pointer -mno-omit-leaf-frame-pointer -g -ffile-prefix-map=/build/jq/src=/usr/src/debug/jq -flto=auto' 'LDFLAGS=-Wl,-O1 -Wl,--sort-common -Wl,--as-needed -Wl,-z,relro -Wl,-z,now          -Wl,-z,pack-relative-relocs -flto=auto'\"},{\"vaddr\":24608,\"paddr\":24608,\"ordinal\":17,\"size\":49,\"length\":48,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"For listing the command options, use jq --help.\\n\"},{\"vaddr\":24664,\"paddr\":24664,\"ordinal\":18,\"size\":37,\"length\":36,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"jq: program file contains NUL bytes\\n\"},{\"vaddr\":24704,\"paddr\":24704,\"ordinal\":19,\"size\":38,\"length\":37,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"jq: error: writing output failed: %s\\n\"},{\"vaddr\":24744,\"paddr\":24744,\"ordinal\":20,\"size\":23,\"length\":22,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"jq: error (at %s): %s\\n\"},{\"vaddr\":24767,\"paddr\":24767,\"ordinal\":21,\"size\":7,\"length\":6,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"DEBUG:\"},{\"vaddr\":24774,\"paddr\":24774,\"ordinal\":22,\"size\":8,\"length\":7,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"rawfile\"},{\"vaddr\":24782,\"paddr\":24782,\"ordinal\":23,\"size\":10,\"length\":9,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"slurpfile\"},{\"vaddr\":24794,\"paddr\":24794,\"ordinal\":24,\"size\":8,\"length\":7,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"jq_init\"},{\"vaddr\":24802,\"paddr\":24802,\"ordinal\":25,\"size\":6,\"length\":5,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"slurp\"},{\"vaddr\":24808,\"paddr\":24808,\"ordinal\":26,\"size\":11,\"length\":10,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"raw-output\"},{\"vaddr\":24819,\"paddr\":24819,\"ordinal\":27,\"size\":12,\"length\":11,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"raw-output0\"},{\"vaddr\":24831,\"paddr\":24831,\"ordinal\":28,\"size\":12,\"length\":11,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"join-output\"},{\"vaddr\":24843,\"paddr\":24843,\"ordinal\":29,\"size\":15,\"length\":14,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"compact-output\"},{\"vaddr\":24858,\"paddr\":24858,\"ordinal\":30,\"size\":13,\"length\":12,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"color-output\"},{\"vaddr\":24871,\"paddr\":24871,\"ordinal\":31,\"size\":18,\"length\":17,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"monochrome-output\"},{\"vaddr\":24889,\"paddr\":24889,\"ordinal\":32,\"size\":13,\"length\":12,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"ascii-output\"},{\"vaddr\":24902,\"paddr\":24902,\"ordinal\":33,\"size\":11,\"length\":10,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"unbuffered\"},{\"vaddr\":24913,\"paddr\":24913,\"ordinal\":34,\"size\":10,\"length\":9,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"sort-keys\"},{\"vaddr\":24923,\"paddr\":24923,\"ordinal\":35,\"size\":10,\"length\":9,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"raw-input\"},{\"vaddr\":24933,\"paddr\":24933,\"ordinal\":36,\"size\":11,\"length\":10,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"null-input\"},{\"vaddr\":24944,\"paddr\":24944,\"ordinal\":37,\"size\":10,\"length\":9,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"from-file\"},{\"vaddr\":24954,\"paddr\":24954,\"ordinal\":38,\"size\":13,\"length\":12,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"library-path\"},{\"vaddr\":24967,\"paddr\":24967,\"ordinal\":39,\"size\":7,\"length\":6,\"section\":\".rodata\",\"type\":\"ascii\",\"string\":\"binary\"},{\"vaddr\":24978,\"paddr\":24978,\"ordinal\":40,\"size\":7,\"length\"