+def rev_state(root: str, rev: str | None) -> dict:
+    """A receipt names only a revision the repo actually contains (QUALITY 146)."""
+    if not rev:
+        raise Unevaluable("rev_required: pass --rev <commit>")
+    rec = run(["git", "-C", root, "cat-file", "-e", f"{rev}^{{commit}}"], dict(os.environ))
+    if rec["rc"] != 0:
+        raise Unevaluable(f"rev_not_committed: {rev}")
+    head = run(["git", "-C", root, "rev-parse", f"{rev}^{{commit}}"], dict(os.environ))
+    dirty = run(["git", "-C", root, "status", "--porcelain"], dict(os.environ))
+    return {"rev": rev, "commit": (head.get("stdout") or "").strip(),
+            "worktree_dirty_paths": len([ln for ln in (dirty.get("stdout") or "").splitlines() if ln])}
+
