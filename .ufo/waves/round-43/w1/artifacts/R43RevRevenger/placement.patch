+def run_tuple_check(dir_, quiet=False):
+    """`--tuple-check DIR`: the refusal, run over a COMMITTED held-out directory.
+
+    Exists so the refusal is demonstrable on frozen bytes with no REA and no
+    generator state (round-43 control CTL-C1-2): point it at any manifest +
+    envelope set and it answers with the same exit code the inline gate would
+    have produced.  It writes nothing.
+    """
+    path = os.path.join(dir_, 'manifest.json')
+    if not os.path.isfile(path):
+        print(f'no manifest at {path}', file=sys.stderr)
+        return 2
+    with open(path, encoding='utf-8') as handle:
+        manifest = json.load(handle)
+    carriers = manifest.get('carriers') or []
+    if not carriers:
+        print(f'{path}: manifest holds no carriers', file=sys.stderr)
+        return 2
+    verdict = refusal_check(dir_, carriers)
+    for row in verdict['rows']:
+        if row['verdict'] == 'match':
+            continue
+        if row['verdict'] == 'no_declared_tuple':
+            print(f"REFUSE {row['id']}  {row['class']}  no declared tuple")
+        elif row['verdict'] == 'no_envelope':
+            print(f"REFUSE {row['id']}  {row['class']}  no usable envelope")
+        else:
+            for diff in row['diff']:
+                print(f"REFUSE {row['id']}  {row['class']}  {diff['field']}: "
+                      f"declared {diff['declared']!r} observed {diff['observed']!r}")
+    for note in verdict['missing']:
+        print(f"REFUSE {note}  envelope file missing")
+    for note in verdict['unparsable']:
+        print(f"REFUSE {note}  envelope unparsable")
+    if not quiet:
+        print(f"tuple check over {verdict['carriers_checked']} carriers "
+              f"({verdict['carriers_checked'] - len(verdict['mismatched'])} declare "
+              f"what their envelope shows) -> "
+              f"{'PASS' if verdict['ok'] else 'REFUSE'}")
+    if verdict['missing'] or verdict['unparsable']:
+        return 2
+    return 0 if verdict['ok'] else REFUSAL_UNOBSERVED
+
