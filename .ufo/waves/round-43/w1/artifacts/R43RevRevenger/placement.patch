+def refusal_check(out_dir, carriers):
+    """R43 refusal: every carrier's observed six-field tuple == its declared one.
+
+    Returns a verdict dict; it never writes and never mutates a carrier.  `ok`
+    is false when any carrier mismatches, carries no declared tuple, or has no
+    usable envelope -- a missing observation is a refusal, never a pass.
+    """
+    observed, missing, unparsable = collect_observed(out_dir, carriers)
+    rows, mismatched = [], []
+    for entry in carriers:
+        cid = str(entry['id'])
+        declared = entry.get(DECLARED_KEY)
+        got = observed.get(cid)
+        if not isinstance(declared, dict):
+            rows.append({'id': cid, 'class': entry.get('class'),
+                         'verdict': 'no_declared_tuple', 'diff': []})
+            mismatched.append(cid)
+            continue
+        declared6 = {key: declared.get(key) for key in DECLARED_FIELDS}
+        if got is None:
+            rows.append({'id': cid, 'class': entry.get('class'),
+                         'verdict': 'no_envelope', 'diff': []})
+            mismatched.append(cid)
+            continue
+        observed6 = {key: got[key] for key in DECLARED_FIELDS}
+        diff = [{'field': key, 'declared': declared6[key], 'observed': observed6[key]}
+                for key in DECLARED_FIELDS if declared6[key] != observed6[key]]
+        rows.append({'id': cid, 'class': entry.get('class'),
+                     'verdict': 'match' if not diff else 'mismatch',
+                     'declared': declared6, 'observed': observed6,
+                     'diff': diff})
+        if diff:
+            mismatched.append(cid)
+    summary = {
+        'rule': 'every observed six-field tuple equals its declared tuple '
+                '(R43-C1; routed defect R42-CL1 / M42-2)',
+        'observation': ('rea-full.json per carrier, through _envelope_parts + '
+                        'observed_features -- not run.json'),
+        'fields': list(DECLARED_FIELDS),
+        'carriers_checked': len(rows),
+        'mismatched': mismatched,
+        'all_equal': not mismatched,
+        'carriers': {row['id']: {'verdict': row['verdict'],
+                                 'declared': row.get('declared'),
+                                 'observed': row.get('observed')}
+                     for row in rows},
+    }
+    return {'ok': not mismatched, 'rows': rows, 'mismatched': mismatched,
+            'carriers_checked': len(rows), 'missing': missing,
+            'unparsable': unparsable, 'summary': summary}
+
