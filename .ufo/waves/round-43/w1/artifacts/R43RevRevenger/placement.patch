+def read_envelope(out_dir, carrier_id):
+    """The full `{ok, data, meta}` envelope for one carrier, or None."""
+    dest = os.path.join(out_dir, carrier_id)
+    plain = os.path.join(dest, 'rea-full.json')
+    if os.path.isfile(plain):
+        with open(plain, encoding='utf-8') as handle:
+            return json.load(handle)
+    packed = plain + '.gz'
+    if os.path.isfile(packed):
+        with gzip.open(packed, 'rt', encoding='utf-8') as handle:
+            return json.load(handle)
+    return None
+
+
+def collect_observed(out_dir, carriers):
+    """id -> observed tuple, RE-DERIVED from each emitted envelope.
+
+    R43 (QUALITY 85): the round-42 `--verify` read `run.json`, which is the
+    generator's own summary of the same in-memory shape.  The refusal reads the
+    envelope itself (`rea-full.json`), so the observation is made from the bytes
+    the run emitted, and the check can be re-run by a counter on a committed
+    directory with no generator state at all.
+    """
+    observed, missing, unparsable = {}, [], []
+    for entry in carriers:
+        cid = str(entry['id'])
+        try:
+            full = read_envelope(out_dir, cid)
+        except Exception as exc:
+            unparsable.append(f'{cid}: {exc!r}'.replace('\n', ' ')[:160])
+            continue
+        if full is None:
+            missing.append(cid)
+            continue
+        data, _sha, shape = _envelope_parts(full)
+        if data is None:
+            unparsable.append(f'{cid}: no data object')
+            continue
+        observed[cid] = observed_features(shape)
+    return observed, missing, unparsable
+
