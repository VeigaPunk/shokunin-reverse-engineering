+def serialize_manifest(manifest, drop_tuple_check=False):
+    """The manifest's bytes, exactly as `write_manifest` emits them.
+
+    R43 (QUALITY 85): `build_set` no longer writes the manifest -- the only write
+    is `write_manifest`, reached from `main` AFTER a full `--run` pass and a
+    passing refusal check.  `--verify`'s regen arm and `--selftest` compare this
+    serialization in memory, so neither has to create an unobserved manifest file
+    to compare bytes.
+    """
+    obj = manifest
+    if drop_tuple_check:
+        obj = json.loads(json.dumps(manifest))
+        (obj.get('generator') or {}).pop('tuple_check', None)
+    return (json.dumps(obj, indent=2) + '\n').encode('utf-8')
+
+
+def write_manifest(manifest, out_dir):
+    """The ONLY manifest write in this program (callers must have observed)."""
+    with open(os.path.join(out_dir, 'manifest.json'), 'wb') as handle:
+        handle.write(serialize_manifest(manifest))
+
+
