+# ---------------------------------------------------------------------------
+# ROUND 43: measured manifest finalization (QUALITY 85 / routed R42-CL1)
+#
+# Round 42 declared a feature tuple from the class/factors and wrote the manifest
+# without ever comparing that declaration with what its own --run observed.  The
+# round-42 held-out arm then shipped a manifest whose combo C02 declaration
+# lacked `depth-limited` (observed: depth-limited + extractor-failure +
+# unpublished-entry), and the round stopped on that binding -- the M42-2 defect.
+#
+# Round 43 keeps the declaration a PURE FUNCTION of the class and its factors (it
+# is never copied out of a run) and makes the FINALIZATION measured instead:
+#
+#   * after --run the generator measures each carrier's six-field tuple in the
+#     envelope its own run produced (its own observed_features(), over the
+#     artifact on disk) and compares it with the tuple the manifest declares;
+#   * ANY difference -> print the per-carrier diff list, write NO manifest, and
+#     exit 3 with the reason `declared_tuple_unobserved`;
+#   * full agreement -> write the manifest, recording the measurement under
+#     `generator.tuple_check` (per carrier {observed, declared, equal: true} plus
+#     the rule text).
+#
+# `--verify` re-runs the same check over the envelopes on disk and fails on a
+# mismatch; `--tuple-check DIR` runs ONLY the check against an existing directory
+# (read-only), which is what the claim's red/green control needs.
+# ---------------------------------------------------------------------------
+TUPLE_CHECK_KEY = 'tuple_check'
+EXIT_DECLARED_TUPLE_UNOBSERVED = 3
+REASON_DECLARED_TUPLE_UNOBSERVED = 'declared_tuple_unobserved'
+TUPLE_CHECK_RULE = (
+    'R42-CL1 (QUALITY 85): a declared feature tuple is written into the manifest '
+    'only after this generator MEASURED the same six fields in the envelope its '
+    'own --run produced for that carrier (observed_features, over the artifact '
+    'on disk) and found them EQUAL; on any difference it writes NO manifest and '
+    'exits 3 (declared_tuple_unobserved).')
+
+
+def write_manifest_file(out_dir, manifest):
+    """The ONE writer of manifest.json: round 42's bytes (indent=2 + newline)."""
+    with open(os.path.join(out_dir, 'manifest.json'), 'w', encoding='utf-8') as handle:
+        json.dump(manifest, handle, indent=2)
+        handle.write('\n')
+
+
+def manifest_projection(manifest):
+    """The manifest WITHOUT the finalize-only measurement block.
+
+    ``generator.tuple_check`` records a measurement of a --run, so a rebuild that
+    runs no REA cannot reproduce it.  Every other manifest byte is a function of
+    the seed, and `--verify`'s byte-regeneration check compares exactly those
+    bytes; the measurement block is checked separately against the envelopes.
+    """
+    projection = json.loads(json.dumps(manifest))
+    generator_block = projection.get('generator')
+    if isinstance(generator_block, dict):
+        generator_block.pop(TUPLE_CHECK_KEY, None)
+    return projection
+
+
+def _read_json_any(path):
+    """Parse a .json or .json.gz file, or None when absent/unreadable."""
+    if not os.path.isfile(path):
+        return None
+    if path.endswith('.gz'):
+        with gzip.open(path, 'rb') as handle:
+            return json.loads(handle.read().decode('utf-8'))
+    with open(path, encoding='utf-8') as handle:
+        return json.load(handle)
+
+
+def envelope_shape_on_disk(carrier_dir):
+    """The shape summary of one PRODUCED envelope, re-derived from the artifact.
+
+    Reads ``envelope.json`` (REA's `data` object) or ``rea-full.json`` (the whole
+    {ok,data,meta} envelope), plain or gzip, and runs the SAME extraction the run
+    itself used -- so the measurement is taken from the committed artifact, not
+    from the generator's own bookkeeping.
+    """
+    for name in ('envelope.json', 'envelope.json.gz',
+                 'rea-full.json', 'rea-full.json.gz'):
+        payload = _read_json_any(os.path.join(carrier_dir, name))
+        if payload is None:
+            continue
+        data = payload
+        if name.startswith('rea-full') and isinstance(payload, dict):
+            data = payload.get('data')
+        if isinstance(data, dict):
+            return shape_of_data(data)
+    return None
+
+
+def canonical_tuple(values):
+    """A tuple's six fields, with list fields sorted (order-free comparison)."""
+    out = {}
+    for key in DECLARED_FIELDS:
+        value = values.get(key) if isinstance(values, dict) else None
+        out[key] = sorted(value) if isinstance(value, list) else value
+    return out
+
+
+def declared_tuple_of(entry):
+    """The six fields a carrier entry declares, or None.
+
+    R41-CL1: the binding tuple is read from EXACTLY ONE key, ``declared_features``.
+    A tuple written under ``declared`` or ``class_expected.features`` is
+    INVISIBLE, so a manifest using another spelling FAILS the check instead of
+    passing on a second key.
+    """
+    if not isinstance(entry, dict):
+        return None
+    value = entry.get(DECLARED_KEY)
+    if not isinstance(value, dict):
+        return None
+    if any(key not in value for key in DECLARED_FIELDS):
+        return None
+    return canonical_tuple(value)
+
+
+def observed_tuple(shape):
+    """The six binding fields, as observed in one envelope."""
+    features = observed_features(shape or {})
+    return {key: features.get(key) for key in DECLARED_FIELDS}
+
+
+def diff_tuple(declared, observed):
+    """Field-by-field difference; empty means the observed tuple WAS declared."""
+    return {key: {'declared': declared.get(key), 'observed': observed.get(key)}
+            for key in DECLARED_FIELDS if declared.get(key) != observed.get(key)}
+
+
+def tuple_check(carriers, observed_by_id):
+    """Per-carrier differences between the DECLARED and the MEASURED tuple.
+
+    Returns one record per disagreeing carrier:
+    {'id', 'class', 'reason', 'differ': {field: {'declared', 'observed'}}}.
+    An empty list means every carrier observed exactly what it declared.
+    """
+    diffs = []
+    for entry in carriers:
+        cid = entry.get('id')
+        declared = declared_tuple_of(entry)
+        observed = observed_by_id.get(cid)
+        if declared is None:
+            diffs.append({'id': cid, 'class': entry.get('class'),
+                          'reason': 'declared_features_absent', 'differ': {}})
+            continue
+        if observed is None:
+            diffs.append({'id': cid, 'class': entry.get('class'),
+                          'reason': 'no_envelope_measured', 'differ': {}})
+            continue
+        differ = diff_tuple(declared, observed)
+        if differ:
+            diffs.append({'id': cid, 'class': entry.get('class'),
+                          'reason': 'declared_tuple_unobserved',
+                          'differ': differ})
+    return diffs
+
+
+def measure_out_dir(out_dir, carriers):
+    """{carrier id: observed six-field tuple} from the envelopes on disk."""
+    observed = {}
+    for entry in carriers:
+        cid = entry.get('id')
+        if not isinstance(cid, str) or not cid:
+            continue
+        shape = envelope_shape_on_disk(os.path.join(out_dir, cid))
+        if shape is not None:
+            observed[cid] = observed_tuple(shape)
+    return observed
+
+
+def print_tuple_diffs(diffs):
+    """The per-carrier diff list on stdout."""
+    for record in diffs:
+        head = f"{record['id']}  {record['class']}"
+        if record['reason'] == 'declared_features_absent':
+            print(f"{head}  DECLARED-FEATURES-ABSENT  the tuple is read from "
+                  f"`{DECLARED_KEY}` only (R41-CL1)")
+            continue
+        if record['reason'] == 'no_envelope_measured':
+            print(f"{head}  NO-ENVELOPE  nothing was measured for this carrier")
+            continue
+        for key in DECLARED_FIELDS:
+            if key in record['differ']:
+                field = record['differ'][key]
+                print(f"{head}  {key}: declared {field['declared']!r} != "
+                      f"observed {field['observed']!r}")
+
+
+def tuple_check_block(carriers, observed_by_id):
+    """The manifest's record of the check that authorised it."""
+    records = {}
+    for entry in carriers:
+        cid = entry.get('id')
+        declared = declared_tuple_of(entry)
+        observed = observed_by_id.get(cid)
+        records[cid] = {
+            'observed': observed,
+            'declared': declared,
+            'equal': bool(declared is not None and observed is not None
+                          and not diff_tuple(declared, observed)),
+        }
+    return {'rule': TUPLE_CHECK_RULE,
+            'fields': list(DECLARED_FIELDS),
+            'measured': True,
+            'all_equal': all(record['equal'] for record in records.values()),
+            'carriers': records}
+
+
+def finalize_manifest(out_dir, manifest, carriers):
+    """Measure, compare, and only then write the manifest (QUALITY 85).
+
+    Returns 0 when the manifest was written and 3 when it was refused.  On a
+    refusal NO manifest is written: the caller must not have written one earlier.
+    """
+    observed_by_id = measure_out_dir(out_dir, carriers)
+    diffs = tuple_check(carriers, observed_by_id)
+    if diffs:
+        print(f"{REASON_DECLARED_TUPLE_UNOBSERVED}: {len(diffs)} of "
+              f"{len(carriers)} carrier(s) observed a tuple the manifest would "
+              f"not have declared -- writing NO manifest")
+        print_tuple_diffs(diffs)
+        return EXIT_DECLARED_TUPLE_UNOBSERVED
+    manifest['generator'][TUPLE_CHECK_KEY] = tuple_check_block(carriers,
+                                                               observed_by_id)
+    write_manifest_file(out_dir, manifest)
+    print(f"tuple_check: measured {len(observed_by_id)}/{len(carriers)} "
+          f"carrier(s); every observed tuple equals its declared tuple.  Manifest "
+          f"written with generator.{TUPLE_CHECK_KEY}.")
+    return 0
+
+
+def run_tuple_check_dir(dir_path):
+    """Run ONLY the tuple check against an existing held-out directory (read-only)."""
+    manifest = _read_json_any(os.path.join(dir_path, 'manifest.json'))
+    if not isinstance(manifest, dict):
+        print(f"tuple_check: no manifest.json under {dir_path}")
+        return 2
+    carriers = [c for c in (manifest.get('carriers') or []) if isinstance(c, dict)]
+    observed_by_id = measure_out_dir(dir_path, carriers)
+    diffs = tuple_check(carriers, observed_by_id)
+    if diffs:
+        print(f"{REASON_DECLARED_TUPLE_UNOBSERVED}: {len(diffs)} of "
+              f"{len(carriers)} carrier(s) observed a tuple the manifest does "
+              f"not declare")
+        print_tuple_diffs(diffs)
+        return EXIT_DECLARED_TUPLE_UNOBSERVED
+    print(f"tuple_check: {len(carriers)} carrier(s); every observed tuple equals "
+          f"its declared tuple")
+    return 0
+
