ata-bits: RX data bits"},{"line_number":25,"text":"- tx-data-bits: TX data bits"},{"line_number":26,"text":"- rx-break: RX break"},{"line_number":27,"text":"- tx-break: TX break"},{"line_number":28,"text":"- rx-packet: RX packet"},{"line_number":29,"text":"- tx-packet: TX packet"},{"line_number":30,"text":"Annotation rows:"},{"line_number":31,"text":"- rx-data-bits (RX bits): rx-data-bits"},{"line_number":32,"text":"- rx-data (RX): rx-data, rx-start, rx-parity-ok, rx-parity-err, rx-stop"},{"line_number":33,"text":"- rx-warnings (RX warnings): rx-warnings"},{"line_number":34,"text":"- rx-break (RX break): rx-break"},{"line_number":35,"text":"- rx-packets (RX packets): rx-packet"},{"line_number":36,"text":"- tx-data-bits (TX bits): tx-data-bits"},{"line_number":37,"text":"- tx-data (TX): tx-data, tx-start, tx-parity-ok, tx-parity-err, tx-stop"},{"line_number":38,"text":"- tx-warnings (TX warnings): tx-warnings"},{"line_number":39,"text":"- tx-break (TX break): tx-break"},{"line_number":40,"text":"- tx-packets (TX packets): tx-packet"},{"line_number":41,"text":"Binary classes:"},{"line_number":42,"text":"- rx: RX dump"},{"line_number":43,"text":"- tx: TX dump"},{"line_number":44,"text":"- rxtx: RX/TX dump"},{"line_number":45,"text":"Required channels:"},{"line_number":46,"text":"None."},{"line_number":47,"text":"Optional channels:"},{"line_number":48,"text":"- rx (RX): UART receive line"},{"line_number":49,"text":"- tx (TX): UART transmit line"},{"line_number":50,"text":"Options:"},{"line_number":51,"text":"- baudrate: Baud rate (default 115200)"},{"line_number":52,"text":"- data_bits: Data bits (5, 6, 7, 8, 9, default 8)"},{"line_number":53,"text":"- parity: Parity ('none', 'odd', 'even', 'zero', 'one', 'ignore', default 'none')"},{"line_number":54,"text":"- stop_bits: Stop bits (0.0, 0.5, 1.0, 1.5, default 1.0)"},{"line_number":55,"text":"- bit_order: Bit order ('lsb-first', 'msb-first', default 'lsb-first')"},{"line_number":56,"text":"- format: Data format ('ascii',